# godley-os-bot environment. Copy to .env for local development.
# NEVER commit real values — real values live only in the Render dashboard
# (and in .env locally, which is gitignored).

# Port the HTTP server binds to. Render injects PORT automatically on its
# side; this is only needed for local runs.
PORT=3000

# Slack app -> Basic Information -> App Credentials -> Signing Secret.
# Used to verify that every request to /slack/events and /slack/interactions
# really came from Slack (HMAC SHA-256).
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Slack app -> OAuth & Permissions -> Bot User OAuth Token (starts xoxb-).
# Not used yet (no outbound Slack messages in the skeleton); wired in when
# the pipeline starts posting.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Supabase project -> Settings -> API.
SUPABASE_URL=https://your-project.supabase.co

# Service-role key: bypasses RLS. Server-side only — never ship it to a
# browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer secret for the admin routes (POST /admin/deliver-now — run one
# report-delivery poll cycle immediately, for testing without waiting on the
# Monday cron). Any long random string; with it unset the routes refuse
# everything (fail closed).
ADMIN_SECRET=any-long-random-string

# openrouter.ai -> Keys. The ONE AI account the bot bills to: both the AI
# Manager (Claude Haiku, src/integrations/anthropic.ts) and the WhatsApp
# framing agent (GPT-4o mini, src/integrations/openai.ts) call OpenRouter
# with this key by default (src/integrations/openrouter.ts).
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Which provider the two model clients use. Leave unset: OpenRouter when
# OPENROUTER_API_KEY is set, otherwise the direct providers below (warned in
# the log on every call). "openrouter" = always OpenRouter (a missing key is
# a loud error); "direct" = always api.anthropic.com / api.openai.com with
# the two keys below — the escape hatch for anything OpenRouter can't proxy
# (see the openrouter.ts header).
AI_PROVIDER=

# console.anthropic.com -> API Keys. Direct-provider path only
# (AI_PROVIDER=direct, or no OpenRouter key). The edge functions
# (claude-bridge, weekly-insight) keep using this key regardless — they need
# Anthropic-native features OpenRouter can't proxy.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# The workspace owner's Slack MEMBER id (starts with U). Only this user can
# trigger and confirm the AI Manager's actions (approve/reject/draft);
# everyone else in #studio-admin gets read-only answers. Unset = all manager
# actions disabled (fail closed). Find yours in Slack: your profile ->
# "..." (three dots) -> "Copy member ID".
OWNER_SLACK_USER_ID=U0XXXXXXXXX

# platform.openai.com -> API Keys. Direct-provider path only
# (AI_PROVIDER=direct, or no OpenRouter key) for the WhatsApp framing agent
# (src/integrations/openai.ts): reframes an approved weekly brief as a
# WhatsApp-ready message, filed as a new pending proposal.
OPENAI_API_KEY=sk-your-openai-key

# Blotato dashboard -> API key, used by the social publishing client
# (src/integrations/blotato.ts). IMPORTANT: generating the real key starts
# Blotato billing — until live-test time, leave the literal value "pending":
# the client then runs in DRY-RUN mode (logs the exact request it would
# send, sends nothing). Real keys may end in "=" padding — keep it verbatim.
BLOTATO_API_KEY=pending

# Optional: force publishing dry-run even with a real key set ("1" = on).
BLOTATO_DRY_RUN=

# elevenlabs.io -> Profile -> API Keys. Narrates approved video scripts in
# the venture's cloned voice (src/integrations/elevenlabs.ts). Cloned voices
# need the Creator plan or higher. Spent only after a video.script approval.
ELEVENLABS_API_KEY=xi-your-elevenlabs-key

# pictory.ai -> API (self-serve API plan) -> API key (starts pictai_).
# Assembles visuals + captions around the ElevenLabs narration
# (src/integrations/pictory.ts). Spent only after a video.script approval.
PICTORY_API_KEY=pictai_your_pictory_key

# Optional: "1" makes the video_jobs ledger log what it WOULD narrate and
# render, spend nothing, and record the job as 'dry-run'.
VIDEO_DRY_RUN=
