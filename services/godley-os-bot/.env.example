# godley-os-bot environment. Copy to .env for local development.
# NEVER commit real values — real values live only in the Render dashboard
# (and in .env locally, which is gitignored).

# Port the HTTP server binds to. Render injects PORT automatically on its
# side; this is only needed for local runs.
PORT=3000

# Slack app -> Basic Information -> App Credentials -> Signing Secret.
# Used to verify that every request to /slack/events and /slack/interactions
# really came from Slack (HMAC SHA-256).
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Slack app -> OAuth & Permissions -> Bot User OAuth Token (starts xoxb-).
# Not used yet (no outbound Slack messages in the skeleton); wired in when
# the pipeline starts posting.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Supabase project -> Settings -> API.
SUPABASE_URL=https://your-project.supabase.co

# Service-role key: bypasses RLS. Server-side only — never ship it to a
# browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# console.anthropic.com -> API Keys. Used by the research stub.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# platform.openai.com -> API Keys. Used by the content-framing stub.
OPENAI_API_KEY=sk-your-openai-key

# Blotato dashboard -> API key. Publishing is not implemented yet; the key is
# documented now so the Render environment is complete from day one.
BLOTATO_API_KEY=your-blotato-api-key
