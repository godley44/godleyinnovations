{
  "name": "godley-os-bot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Slack bot backend for the Godley Innovations OS: events in, signatures verified, approvals written to Supabase.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@hono/node-server": "^1.14.0",
    "@supabase/supabase-js": "^2.48.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
